@page
@model CarlosM_ExamenP1.Views.Propietario.CreateModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create</title>
</head>
<body>

<h4>Propietario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Propietario.Nombre" class="control-label"></label>
                <input asp-for="Propietario.Nombre" class="form-control" />
                <span asp-validation-for="Propietario.Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Propietario.Correo" class="control-label"></label>
                <input asp-for="Propietario.Correo" class="form-control" />
                <span asp-validation-for="Propietario.Correo" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <span class="text-danger">*</span>
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Propietario.MascotaRegistrada" /> @Html.DisplayNameFor(model => model.Propietario.MascotaRegistrada)
                </label>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Propietario.DateOnly" class="control-label"></label>
                <input asp-for="Propietario.DateOnly" class="form-control" />
                <span asp-validation-for="Propietario.DateOnly" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Propietario.GastoMascota" class="control-label"></label>
                <input asp-for="Propietario.GastoMascota" class="form-control" />
                <span asp-validation-for="Propietario.GastoMascota" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

</body>
</html>
